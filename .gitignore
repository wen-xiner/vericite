# 毕设基准文档（仅本地，不上传）
毕设大纲基准.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 数据与模型
# 语料元数据体积小（约 250K）且是评测集引用的依据，入库以保证可核验；
# data/raw/ 是 arXiv 原始响应缓存，可由 fetch_arxiv.py 重新拉取，不入库。
data/*
!data/.gitkeep
!data/arxiv_raw.jsonl
corpus/*
!corpus/.gitkeep
*.bin
*.faiss
*.ckpt
*.pt
*.onnx

# 实验输出
experiments/runs/
*.log

# 构建脚本的断点/进度文件（可再生产物，不入库）
eval/v1/.*
*.tmp

# 注意：eval/ 下的评测集是核心资产，必须入库，不要加进忽略规则

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 密钥
.env
*.key

# 工作记忆/会话数据（本地产物，不入库）
.workbuddy/
